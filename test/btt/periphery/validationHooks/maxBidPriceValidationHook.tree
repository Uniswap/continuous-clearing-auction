MaxBidPriceValidationHookTest
├── constructor
│   └── it sets maxBidPrice
├── validate
│   ├── when maxBidPrice is 0
│   │   └── it does not revert
│   └── when maxBidPrice is not 0
│       ├── when maxPrice GT maxBidPrice
│       │   └── it reverts with {MaxBidPriceExceeded}
│       └── when maxPrice LTE maxBidPrice
│           ├── when maxPrice EQ maxBidPrice
│           │   └── it does not revert
│           └── when maxPrice LT maxBidPrice
│               └── it does not revert
└── supportsInterface
    ├── when interface is supported
    │   └── it returns true
    └── when interface is not supported
        └── it returns false
